{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "height": 4,
    "width": 8,
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────System────────────┐"
    },
    {
      "type": "host",
      "key": "󰌢 ",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "󰻠 ",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "󰍹 ",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "󰑭 ",
      "keyColor": "green"
    },
    {
      "type": "os",
      "key": " ",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "󱂬 ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "󰆍 ",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "󰥔 ",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└───────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 1,
      "symbol": "circle"
    }
  ]
}
